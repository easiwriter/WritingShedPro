{
  "namespace": "/api/sync/production/v1",
  "phase": "server-foundation",
  "policy": {
    "readOnly": true,
    "d1WritesAllowed": false,
    "r2WritesAllowed": false,
    "swiftDataMutationAllowed": false,
    "cursorAdvanceAllowed": false,
    "rolloutEnableAllowed": false,
    "cacheControl": "no-store",
    "maxAssetManifestItems": 1000,
    "maxApplyWindowOperations": 500
  },
  "schema": {
    "requiredTables": [
      "sync_schema_versions",
      "sync_environments",
      "sync_rollout_flags",
      "sync_users",
      "sync_devices",
      "sync_projects",
      "sync_project_entitlements",
      "sync_migration_runs",
      "sync_assets",
      "sync_operations",
      "sync_device_cursors",
      "sync_tombstones",
      "sync_audit_events",
      "sync_support_actions"
    ],
    "safeDefaults": [
      "writes_enabled INTEGER NOT NULL DEFAULT 0",
      "consent_state TEXT NOT NULL DEFAULT 'missing'",
      "lifecycle_state TEXT NOT NULL DEFAULT 'active'",
      "migration_state TEXT NOT NULL DEFAULT 'not_started'",
      "latest_sequence INTEGER NOT NULL DEFAULT 0",
      "can_write INTEGER NOT NULL DEFAULT 0",
      "state TEXT NOT NULL DEFAULT 'planned'",
      "transfer_state TEXT NOT NULL DEFAULT 'pending'",
      "last_pulled_sequence INTEGER NOT NULL DEFAULT 0",
      "last_pushed_sequence INTEGER NOT NULL DEFAULT 0",
      "last_applied_sequence INTEGER NOT NULL DEFAULT 0",
      "apply_state TEXT NOT NULL DEFAULT 'idle'"
    ],
    "requiredForeignKeys": [
      "FOREIGN KEY(user_id) REFERENCES sync_users(id)",
      "FOREIGN KEY(project_id) REFERENCES sync_projects(id)",
      "FOREIGN KEY(device_id) REFERENCES sync_devices(id)",
      "FOREIGN KEY(target_environment_id) REFERENCES sync_environments(id)",
      "FOREIGN KEY(operation_id) REFERENCES sync_operations(id)"
    ],
    "forbiddenClauses": [
      "ON DELETE CASCADE",
      "ON UPDATE CASCADE"
    ],
    "requiredNullableColumns": [
      "preflight_summary_json TEXT",
      "progress_json TEXT",
      "payload_json TEXT",
      "payload_r2_key TEXT",
      "payload_hash TEXT",
      "redacted_details_json TEXT"
    ],
    "smokeNullableChecks": [
      "nullable_migration_payloads|1|1",
      "nullable_operation_payloads|1|1|1",
      "nullable_audit_details|1"
    ],
    "smokeSequenceScopeChecks": [
      "project_scoped_operation_sequences|2"
    ],
    "uniqueConstraints": [
      "name TEXT NOT NULL UNIQUE",
      "external_subject_hash TEXT NOT NULL UNIQUE",
      "UNIQUE(environment_id, flag_key)",
      "r2_key TEXT NOT NULL UNIQUE",
      "CREATE UNIQUE INDEX IF NOT EXISTS idx_sync_operations_project_sequence",
      "ON sync_operations(project_id, server_sequence)"
    ],
    "smokeDuplicateRejections": [
      "duplicate environment names",
      "duplicate external subject hashes",
      "duplicate rollout flags per environment",
      "duplicate asset storage keys",
      "duplicate project operation sequences"
    ],
    "requiredIndexes": [
      "CREATE INDEX IF NOT EXISTS idx_sync_users_account",
      "ON sync_users(account_id, lifecycle_state)",
      "CREATE INDEX IF NOT EXISTS idx_sync_devices_user",
      "ON sync_devices(user_id, lifecycle_state)",
      "CREATE INDEX IF NOT EXISTS idx_sync_projects_user",
      "ON sync_projects(user_id, migration_state, updated_at DESC)",
      "CREATE INDEX IF NOT EXISTS idx_sync_migration_runs_user_state",
      "ON sync_migration_runs(user_id, state, updated_at DESC)",
      "CREATE INDEX IF NOT EXISTS idx_sync_assets_entity",
      "ON sync_assets(project_id, entity_type, entity_id, transfer_state)",
      "CREATE UNIQUE INDEX IF NOT EXISTS idx_sync_operations_project_sequence",
      "ON sync_operations(project_id, server_sequence)",
      "CREATE INDEX IF NOT EXISTS idx_sync_operations_entity",
      "ON sync_operations(project_id, entity_type, entity_id)",
      "CREATE INDEX IF NOT EXISTS idx_sync_operations_device",
      "ON sync_operations(device_id, received_at)",
      "CREATE INDEX IF NOT EXISTS idx_sync_audit_events_project_created",
      "ON sync_audit_events(project_id, created_at DESC)",
      "CREATE INDEX IF NOT EXISTS idx_sync_audit_events_user_created",
      "ON sync_audit_events(user_id, created_at DESC)",
      "PRIMARY KEY(project_id, user_id)",
      "PRIMARY KEY(project_id, device_id)",
      "PRIMARY KEY(project_id, entity_type, entity_id)"
    ]
  },
  "routes": [
    {
      "route": "/health",
      "method": "GET",
      "public": true,
      "requiresAuth": false,
      "requiresProductionDb": false,
      "requiresProductionBlobs": false,
      "requiredSource": ["writesEnabled: false", "appMutationEnabled: false"],
      "requiredDocs": ["This route performs no writes"]
    },
    {
      "route": "/users/summary",
      "method": "POST",
      "public": false,
      "requiresAuth": true,
      "requiresProductionDb": true,
      "requiresProductionBlobs": false,
      "aggregateOnly": true,
      "handler": "handleSyncProductionUsersSummary",
      "allowedReadTables": ["sync_users", "sync_devices"],
      "forbiddenDetailFields": [
        "external_subject_hash",
        "account_id",
        "project_id",
        "canonical_name",
        "r2_key",
        "payload_json",
        "payload_r2_key"
      ],
      "requiredSource": ["totalUsers", "activeUsers", "writesEnabled: false", "appMutationEnabled: false"],
      "requiredDocs": ["privacy-safe aggregate user and device counts", "performs no writes"]
    },
    {
      "route": "/identity/check",
      "method": "POST",
      "public": false,
      "requiresAuth": true,
      "requiresProductionDb": true,
      "requiresProductionBlobs": false,
      "requiredSource": ["canWrite: false", "writesEnabled: false", "Missing required field: userSubjectHash", "Missing required field: deviceId"],
      "requiredDocs": ["performs no writes", "Missing user/device identity fields"]
    },
    {
      "route": "/identity/enrollment/preflight",
      "method": "POST",
      "public": false,
      "requiresAuth": true,
      "requiresProductionDb": true,
      "requiresProductionBlobs": false,
      "requiredSource": ["readyToEnrollUser: false", "readyToRegisterDevice: false", "production_identity_enrollment_not_implemented"],
      "requiredDocs": ["performs no writes", "readyToEnrollUser: false"]
    },
    {
      "route": "/entitlements/preflight",
      "method": "POST",
      "public": false,
      "requiresAuth": true,
      "requiresProductionDb": true,
      "requiresProductionBlobs": false,
      "requiredSource": ["readyToGrantProjectEntitlement: false", "readyToUpdateProjectEntitlement: false", "production_project_entitlement_writer_not_implemented"],
      "requiredDocs": ["performs no writes", "readyToGrantProjectEntitlement: false"]
    },
    {
      "route": "/environment/preflight",
      "method": "POST",
      "public": false,
      "requiresAuth": true,
      "requiresProductionDb": true,
      "requiresProductionBlobs": false,
      "requiredSource": ["readyToEnableProductionWrites: false", "readyToRunProductionMigration: false", "production_environment_writes_not_enabled"],
      "requiredDocs": ["performs no writes", "readyToEnableProductionWrites: false"]
    },
    {
      "route": "/migration/preflight",
      "method": "POST",
      "public": false,
      "requiresAuth": true,
      "requiresProductionDb": true,
      "requiresProductionBlobs": false,
      "requiredSource": ["readyToApplyMigration: false", "writesEnabled: false", "Missing required field: projectId"],
      "requiredDocs": ["performs no writes", "readyToApplyMigration: false", "Missing project id"]
    },
    {
      "route": "/assets/preflight",
      "method": "POST",
      "public": false,
      "requiresAuth": true,
      "requiresProductionDb": true,
      "requiresProductionBlobs": true,
      "requiredSource": ["readyToAdvanceCursor: false", "cursorAdvanceBlockedUntil: \"all_assets_uploaded_and_verified\"", "Each asset requires id, entityType, entityId, and contentHash", "Each asset byteCount must be a positive integer", "Asset ids must be unique", "Asset proposedR2Key values must be unique"],
      "requiredDocs": ["performs no R2 upload", "readyToAdvanceCursor: false", "missing asset identity fields", "invalid byte counts", "duplicate asset ids", "duplicate proposed R2 keys"]
    },
    {
      "route": "/apply/preflight",
      "method": "POST",
      "public": false,
      "requiresAuth": true,
      "requiresProductionDb": true,
      "requiresProductionBlobs": false,
      "requiredSource": ["readyToApply: false", "cursorAdvanceBlockedUntil: \"swiftdata_apply_committed_under_feature_flag\"", "operationWindow.startSequence must equal baseSequence + 1", "operationWindow.payloadHash is required", "unresolved_dependencies", "pending_assets"],
      "requiredDocs": ["performs no D1 write", "readyToApply: false", "Sequence gaps", "missing payload hashes", "unresolved dependencies", "pending assets"]
    },
    {
      "route": "/orchestrator/eligibility",
      "method": "POST",
      "public": false,
      "requiresAuth": true,
      "requiresProductionDb": true,
      "requiresProductionBlobs": false,
      "requiredSource": ["eligibleToRun: false", "eligibleToApply: false", "eligibleToAdvanceCursor: false", "network_unavailable", "network_recovery_without_prior_transport_failure", "background_refresh_requires_background_state", "Unsupported orchestrator trigger"],
      "requiredDocs": ["performs no writes", "eligibleToRun: false", "Unsupported triggers", "offline state", "background-refresh state"]
    },
    {
      "route": "/release/readiness",
      "method": "POST",
      "public": false,
      "requiresAuth": true,
      "requiresProductionDb": true,
      "requiresProductionBlobs": false,
      "requiredSource": ["readyToRelease: false", "readyToEnableProductionWrites: false", "production_environment_missing", "production_writes_already_enabled", "rollout_flags_missing", "rollout_kill_switch_active", "Missing required field: evidence"],
      "requiredDocs": ["performs no writes", "readyToRelease: false", "Missing evidence payloads", "active rollout kill switches", "already-enabled writes"]
    }
  ]
}