{
  "name": "wsp-support",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "python3 build-prompt.py",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "cf:whoami": "wrangler whoami",
    "messages:d1:create": "wrangler d1 create wsp_messages",
    "messages:d1:list": "wrangler d1 list",
    "messages:d1:migrate": "wrangler d1 execute wsp_messages --remote --file=./sql/messages_schema.sql",
    "messages:d1:migrate:local": "wrangler d1 execute wsp_messages --file=./sql/messages_schema.sql",
    "messages:deploy": "npm run build && wrangler deploy",
    "sync:d1:create": "wrangler d1 create wsp_sync_poc",
    "sync:d1:list": "wrangler d1 list",
    "sync:d1:migrate": "wrangler d1 execute wsp_sync_poc --remote --file=./sql/sync_poc_schema.sql",
    "sync:d1:migrate:local": "wrangler d1 execute wsp_sync_poc --file=./sql/sync_poc_schema.sql",
    "sync:r2:create": "wrangler r2 bucket create wsp-sync-poc",
    "sync:prod:d1:create": "wrangler d1 create wsp_sync_production",
    "sync:prod:d1:list": "wrangler d1 list",
    "sync:prod:d1:migrate": "wrangler d1 execute wsp_sync_production --remote --file=./sql/sync_production_schema.sql",
    "sync:prod:d1:migrate:local": "wrangler d1 execute wsp_sync_production --file=./sql/sync_production_schema.sql",
    "sync:prod:r2:create": "wrangler r2 bucket create wsp-sync-production",
    "sync:prod:validate": "node --check src/index.js && node validate-sync-production-foundation.mjs",
    "sync:prod:validate:all": "npm run sync:prod:validate && sqlite3 :memory: < sql/sync_production_schema.sql"
  },
  "devDependencies": {
    "wrangler": "^4.93.1"
  }
}
